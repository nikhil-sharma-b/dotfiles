.DS_Store

# Neovim generated/cache files
nvim/.config/nvim/lazy-lock.json
nvim/.config/nvim/.luarc.json

# Tmux plugin binaries
tmux/.config/tmux/plugins/

# Tmux-resurrect session snapshots (machine-local, churns constantly)
tmux/.config/tmux/resurrect/

# Fish completions and variables generated by plugins/shell state
fish/.config/fish/completions/
fish/.config/fish/fish_variables

# Karabiner auto-backups
karabiner/.config/karabiner/automatic_backups/

# Chezmoi/Omarchy generated files
*.bak.*
dot_config/nvim/.neoconf.json
dot_config/fish/fish_variables
dot_config/fish/completions/
dot_config/tmux/plugins/
dot_config/tmux/resurrect/
