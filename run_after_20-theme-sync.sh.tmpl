{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh

if [ -x "$HOME/.local/bin/theme-sync" ]; then
    selection="$HOME/Library/Application Support/com.mitchellh.ghostty/auto/theme.ghostty"
    if [ -f "$selection" ]; then
        "$HOME/.local/bin/theme-sync" --no-reload
    else
        "$HOME/.local/bin/theme-sync" "Rose Pine" --no-reload
    fi
fi
{{- end }}
